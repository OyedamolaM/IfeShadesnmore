# App
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret
TRUST_PROXY=false
# Optional frontend override when UI and API are on different domains.
# Example: https://ife-shadesnmore.onrender.com
VITE_API_BASE_URL=
SITE_URL=http://localhost:3000
VITE_SITE_URL=http://localhost:3000
# Optional Google Analytics 4 Measurement ID
# Example: G-XXXXXXXXXX
VITE_GA_MEASUREMENT_ID=
# Optional Google OAuth client ID for customer Google sign-in.
# Use the same Web client ID for both variables.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# Admin bootstrap (created/updated on server start)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-admin-password
# Optional comma-separated recipients for new paid-order notifications.
# Defaults to ADMIN_EMAIL when empty.
ORDER_ALERT_EMAIL=
# Send customer order confirmation email when payment is confirmed.
CUSTOMER_ORDER_EMAIL_ENABLED=true
# Send account welcome email after a customer verifies their signup email.
ACCOUNT_WELCOME_EMAIL_ENABLED=true

# Database
# Local development (SQLite): leave DATABASE_URL empty, optionally set DB_PATH.
DB_PATH=server/data/ife-store.db
# Production (Supabase Postgres): set DATABASE_URL and leave DB_PATH unused.
DATABASE_URL=
# Optional: set true only if your Postgres provider does not support SSL.
PG_DISABLE_SSL=false

# Optional seeding
SEED_DEFAULT_PRODUCTS=false

# Paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co

# SMTP (required for real verification emails)
# Provider priority:
# 1) MAIL_PROVIDER if set (smtp | resend | brevo)
# 2) brevo (when BREVO_API_KEY is set)
# 3) resend (when RESEND_API_KEY is set)
# 4) smtp
MAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=true
SMTP_REQUIRE_TLS=false
SMTP_IGNORE_TLS=false
SMTP_TLS_REJECT_UNAUTHORIZED=true
SMTP_DEBUG=false
MAIL_FROM=
# Optional sender overrides by email type. Falls back to MAIL_FROM when empty.
WELCOME_MAIL_FROM=
ORDER_MAIL_FROM=

# Optional production fallback (recommended on Render if SMTP to Gmail is blocked)
RESEND_API_KEY=
RESEND_API_BASE_URL=https://api.resend.com

# Optional Brevo provider (works over HTTPS and can use a verified sender)
BREVO_API_KEY=
BREVO_API_BASE_URL=https://api.brevo.com

# Supabase Storage uploads for admin product/blog/hero images
# Use the Project URL and service_role key from Supabase project settings.
# The storage bucket should be public so storefront images can load in the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=ife-shadesnmore
SUPABASE_STORAGE_FOLDER=uploads
