# App
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret
TRUST_PROXY=false
# Optional frontend override when UI and API are on different domains.
# Example: https://ife-shadesnmore.onrender.com
VITE_API_BASE_URL=

# Admin bootstrap (created/updated on server start)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-admin-password

# Database
# Local development (SQLite): leave DATABASE_URL empty, optionally set DB_PATH.
DB_PATH=server/data/ife-store.db
# Production (Render/Neon Postgres): set DATABASE_URL and leave DB_PATH unused.
DATABASE_URL=
# Optional: set true only if your Postgres provider does not support SSL.
PG_DISABLE_SSL=false

# Optional seeding
SEED_DEFAULT_PRODUCTS=false

# Paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co

# SMTP (required for real verification emails)
# Provider priority:
# 1) MAIL_PROVIDER if set (smtp | resend | sendgrid)
# 2) sendgrid (when SENDGRID_API_KEY is set)
# 3) resend (when RESEND_API_KEY is set)
# 4) smtp
MAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=true
SMTP_REQUIRE_TLS=false
SMTP_IGNORE_TLS=false
SMTP_TLS_REJECT_UNAUTHORIZED=true
SMTP_DEBUG=false
MAIL_FROM=

# Optional production fallback (recommended on Render if SMTP to Gmail is blocked)
RESEND_API_KEY=
RESEND_API_BASE_URL=https://api.resend.com

# Optional SendGrid provider (works over HTTPS and can use Single Sender Verification)
SENDGRID_API_KEY=
SENDGRID_API_BASE_URL=https://api.sendgrid.com
