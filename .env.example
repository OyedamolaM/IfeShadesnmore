PORT=4000
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
DB_PATH=server/data/ife-store.db

# Security
JWT_SECRET=replace-with-a-long-random-secret

# Admin bootstrap (created/updated at server startup)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Paystack (server-side secret key for transaction initialize/verify)
# NOTE: use secret key only (sk_test_... or sk_live_...), never pk_...
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx
PAYSTACK_BASE_URL=https://api.paystack.co

# SMTP (for real email verification delivery)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=mailer@example.com
SMTP_PASS=replace-with-mail-password
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
SMTP_IGNORE_TLS=false
SMTP_TLS_REJECT_UNAUTHORIZED=true
MAIL_FROM="IfeShadesnMore <mailer@example.com>"
